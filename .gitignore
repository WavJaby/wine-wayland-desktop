# Separate repositories and build trees
/src/
# Scratch runs and their evidence; durable evidence is copied under docs/
/tmp/
# Built release artifacts
/dist/
# Private evidence: logs, captures and dumps that may hold account or machine data
*private*/
# Compiled probes
/probes/**/*.exe
/probes/touch-inject/uinput-inject
# Empty local tool dirs
/.agents/
/.aws/
/.codex/
# Python bytecode
__pycache__/
# Agent-only tools (not product)
/scripts/.agent/
# Agent working state (local by default)
/docs/
/CLAUDE.md

# Broker build output and the superseded Python prototype (local only)
/broker/wine-dispatch
/broker/wine-dispatch-prototype.py

# Signing transaction state, keys and certificates must never be committed
.wine-wayland-signing/
*.pem
*.key
*.p12
*.pfx
